{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Usage Controller",
  "version": "0.1.0",
  "identifier": "dev.aiusage.controller",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "widget",
        "title": "AI Usage Controller",
        "url": "index.html",
        "width": 230,
        "height": 34,
        "x": 0,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "category": "DeveloperTool",
    "shortDescription": "AI runway meter for Claude Code, Codex and Gemini",
    "longDescription": "Shows how much AI runway you have left, warns you before you get cut off, and tells you when you are wasting money.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
