# 32+ random bytes; encrypts the Anthropic admin keys teams paste in. openssl rand -hex 32
SECRET_KEY=
# Lets you replace the price/plan tables: curl -X PUT -H "x-admin-secret: $ADMIN_SECRET" --data @core/data/prices.json $API/v1/admin/tables/prices
ADMIN_SECRET=
# Lemon Squeezy → Settings → Webhooks → signing secret. Point the webhook at $API/v1/webhooks/lemonsqueezy
LEMONSQUEEZY_WEBHOOK_SECRET=
# Comma-separated browser origins allowed to call the API
WEB_ORIGINS=https://aiusage.dev,http://localhost:3000
DATABASE_PATH=aiuc.db
PORT=8787
